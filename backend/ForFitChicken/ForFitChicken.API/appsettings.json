{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Media": {
    "Provider": "Local",
    "Security": {
      "MaxStoredBytes": 9000000000,
      "DailyUploads": 100,
      "DailyInputBytes": 200000000,
      "PerUserDailyUploads": 50,
      "ActiveUploads": 2,
      "MonthlyClassA": 100000,
      "MonthlyClassB": 1000000,
      "ReconcileMaxAgeHours": 24,
      "OrphanGraceHours": 24
    }
  },
  "Telegram": { "Enabled": false },
  "RateLimiting": {
    "Global": { "PermitLimit": 120, "WindowSeconds": 60 },
    "Catalog": { "PermitLimit": 120, "WindowSeconds": 60 },
    "Login": { "PermitLimit": 5, "WindowSeconds": 60 },
    "Checkout": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Admin": { "PermitLimit": 120, "WindowSeconds": 60 },
    "Upload": { "PermitLimit": 10, "WindowSeconds": 60 },
    "ReportConcurrencyLimit": 2
  }
}
