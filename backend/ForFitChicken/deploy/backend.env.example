# TEMPLATE ONLY. Copy to /etc/forfit/backend.env on VPS, replace placeholders there.
# Keep the real file outside Git; root-readable, never print it in logs/chat.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5195
ConnectionStrings__DefaultConnection="Server=REPLACE_SQL_HOST;Database=ForFitChicken_Production;User ID=REPLACE_SQL_USER;Password=REPLACE_SQL_SECRET;Encrypt=true;TrustServerCertificate=false"
Media__Provider=R2
Media__R2__Endpoint=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
Media__R2__BucketName=REPLACE_BUCKET_NAME
Media__R2__AccessKeyId=REPLACE_ACCESS_KEY_ID
Media__R2__SecretAccessKey=REPLACE_SECRET_ACCESS_KEY
Media__RootPath=/var/lib/forfit/media-local
Media__Security__MaxStoredBytes=9000000000
DataProtection__KeysPath=/var/lib/forfit/keys
ReverseProxy__KnownProxies__0=127.0.0.1
# Keep Telegram disabled until the deployment's bot/group are configured.
Telegram__Enabled=false
# Telegram__BotToken=REPLACE_BOT_TOKEN
# Telegram__TargetChatId=REPLACE_GROUP_ID
